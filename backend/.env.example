# PostgreSQL connection (docker compose default shown)
DATABASE_URL=postgresql+psycopg://aivoa:aivoa@localhost:5432/aivoa

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=gemma2-9b-it
# Operational fallback, used when Groq reports GROQ_MODEL as decommissioned
# (gemma2-9b-it was shut down 2025-10-08). Must be a currently supported Groq model.
# Larger option: openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Assignment-era alternatives llama-3.1-8b-instant / llama-3.3-70b-versatile were shut down
# for free/developer tiers on 2026-08-16 and are NOT valid fallbacks.

# Allowed CORS origin for the React dev server
FRONTEND_URL=http://localhost:5173
