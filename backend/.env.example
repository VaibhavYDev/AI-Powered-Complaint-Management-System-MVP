# PostgreSQL connection (docker compose default shown)
DATABASE_URL=postgresql+psycopg://aivoa:aivoa@localhost:5432/aivoa

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=gemma2-9b-it
# Used if Groq reports GROQ_MODEL as decommissioned (gemma2-9b-it was deprecated 2025-10-08).
# Optional larger model for either setting: llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Allowed CORS origin for the React dev server
FRONTEND_URL=http://localhost:5173
